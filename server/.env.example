NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5175

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin123
DATABASE_NAME=mydb
DATABASE_SSL=false
TYPEORM_SYNC=false

REDIS_HOST=localhost
REDIS_PORT=6379
BULL_BOARD_ROUTE=/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin123

JWT_SECRET=dev-only-change-this-jwt-secret-key-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=seev-api
JWT_AUDIENCE=seev-web
REFRESH_TOKEN_SECRET=dev-only-change-refresh-secret-32-chars
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_SECONDS=900
REFRESH_COOKIE_NAME=refresh_token

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRES_SECONDS=900

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:5175/auth/google/success
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:5175/login?error=google_auth_failed

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

JOB_RESEARCH_DEFAULT_SOURCES=topcv,vietnamworks,indeed
JOB_RESEARCH_MAX_JOBS_PER_SOURCE=20
JOB_RESEARCH_SOURCE_CONCURRENCY=3
JOB_RESEARCH_QUERY_CONCURRENCY=4
JOB_RESEARCH_CACHE_TTL_HOURS=12
JOB_RESEARCH_HTTP_TIMEOUT_MS=30000
JOB_RESEARCH_HTTP_RETRIES=2
CV_RESEARCH_STALE_PROCESSING_MINUTES=60

BRIGHTDATA_API_KEY=
BRIGHTDATA_REQUEST_URL=https://api.brightdata.com/request
BRIGHTDATA_ZONE=web_unlocker1
BRIGHTDATA_TIMEOUT_MS=120000

TOPCV_ENABLED=true
TOPCV_BASE_URL=https://www.topcv.vn
TOPCV_SEARCH_URL_TEMPLATE=https://www.topcv.vn/tim-viec-lam-{keyword}?type_keyword=1&sba=1
TOPCV_MAX_DETAIL_JOBS=12
TOPCV_DETAIL_CONCURRENCY=4

VIETNAMWORKS_ENABLED=true
VIETNAMWORKS_BASE_URL=https://www.vietnamworks.com
VIETNAMWORKS_SEARCH_URL=https://ms.vietnamworks.com/job-search/v1.0/search

INDEED_ENABLED=true
INDEED_BASE_URL=https://vn.indeed.com
INDEED_SEARCH_URL_TEMPLATE=https://vn.indeed.com/jobs?q={keyword}&l={location}
INDEED_MAX_DETAIL_JOBS=0
