NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5175

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin123
DATABASE_NAME=mydb
DATABASE_SSL=false
TYPEORM_SYNC=false

REDIS_HOST=localhost
REDIS_PORT=6379
BULL_BOARD_ROUTE=/queues
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=admin123

JWT_SECRET=dev-only-change-this-jwt-secret-key-32-chars
JWT_EXPIRES_IN=15m
JWT_ISSUER=seev-api
JWT_AUDIENCE=seev-web
REFRESH_TOKEN_SECRET=dev-only-change-refresh-secret-32-chars
REFRESH_TOKEN_TTL_SECONDS=2592000
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_MAX_AGE_SECONDS=900
REFRESH_COOKIE_NAME=refresh_token

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
R2_SIGNED_URL_EXPIRES_SECONDS=900

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_SUCCESS_REDIRECT_URL=http://localhost:5175/auth/google/success
GOOGLE_FAILURE_REDIRECT_URL=http://localhost:5175/login?error=google_auth_failed

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
FIRECRAWL_API_KEY=
FIRECRAWL_BASE_URL=https://api.firecrawl.dev/v2
SEEV_ADMIN_EMAIL=admin@seev.local
SEEV_ADMIN_PASSWORD=Admin@123456
SEEV_ADMIN_FULL_NAME=Seev Admin
CV_AUDIT_BATCH_TARGET_CHARACTERS=1600
CV_AUDIT_BATCH_MAX_LINES=12
CV_AUDIT_COVERAGE_TARGET_CHARACTERS=2800
CV_AUDIT_COVERAGE_MAX_LINES=20
CV_AUDIT_CONCURRENCY=6

JOB_RESEARCH_DEFAULT_SOURCES=topcv,vietnamworks,indeed
# Full source list supported by the crawler service:
#   topcv, vietnamworks, indeed, topdev, itviec, careerlink, jobsgo, viecoi
JOB_RESEARCH_MAX_JOBS_PER_SOURCE=20
JOB_RESEARCH_SOURCE_CONCURRENCY=3
JOB_RESEARCH_QUERY_CONCURRENCY=4
JOB_RESEARCH_CACHE_TTL_HOURS=12
JOB_RESEARCH_HTTP_TIMEOUT_MS=30000
JOB_RESEARCH_HTTP_RETRIES=2
CV_RESEARCH_STALE_PROCESSING_MINUTES=60

# Scheduled fixed category-page crawl (nationwide -> job_posts)
CRAWL_CATEGORY_CRON=0 2 * * *
CRAWL_CATEGORY_SOURCES=topcv,vietnamworks,itviec
CRAWL_CATEGORY_MAX_JOBS_PER_SOURCE=50

# Email thông báo kết quả crawl (Resend) — bỏ trống để tắt
RESEND_API_KEY=
MAIL_FROM=Seev Crawler <onboarding@duongle.dev>
CRAWL_NOTIFY_EMAIL=

CRAWLER_API_URL=http://localhost:8000
CRAWLER_BEARER_TOKEN=
CRAWLER_API_TIMEOUT_MS=180000
