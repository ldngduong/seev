# ---- API security ----
# When set, /api/v1/* endpoints require `Authorization: Bearer <token>`.
# The BE must send the same value (CRAWLER_BEARER_TOKEN on its side).
CRAWLER_BEARER_TOKEN=

# ---- Database (PostgreSQL) ----
# Optional: only used when `persist=true` for local debugging.
# The BE is the single production store; the crawler writes nothing in prod.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=admin123
DATABASE_NAME=crawl_job

# ---- Firecrawl (lõi crawl cho nguồn HTML) ----
# topcv, itviec, indeed, jobsgo, viecoi, careerviet qua /v2/scrape (rawHtml,
# 1 credit/page; proxy auto chỉ +4 credits khi cần stealth). vietnamworks &
# topdev là JSON API -> requests thuần, 0 credit.
CRAWLER_FIRECRAWL_API_KEY=
# CRAWLER_FIRECRAWL_URL=https://api.firecrawl.dev/v2
# CRAWLER_FIRECRAWL_CONCURRENCY=2   # Free=2, Hobby=5
# CRAWLER_FIRECRAWL_TIMEOUT_MS=60000
# CRAWLER_FIRECRAWL_WAIT_MS=500
CRAWLER_TOPCV_DETAIL_BATCH_SIZE=8
CRAWLER_ITVIEC_DETAIL_BATCH_SIZE=8
# CRAWLER_FIRECRAWL_MAXAGE_MS=0     # 0 = luôn fresh (mặc định cache 2 ngày)
# CRAWLER_FIRECRAWL_PROXY=auto

# ---- Crawler tuning (optional) ----
# CRAWLER_TIMEOUT=20
# CRAWLER_MAX_RETRIES=3
# CRAWLER_RETRY_BACKOFF=1.0
# CRAWLER_SOURCE_DELAY=0.8
# CRAWLER_SOURCE_TIMEOUT=45
